# Пример переменных среды для ЛОКАЛЬНОЙ разработки. Секретов здесь нет и быть не должно.
# Реальные значения задавайте через `dotnet user-secrets` или переменные среды своей оболочки.

# Dev-аутентификация. Выключена по умолчанию; работает только в Development и только на loopback.
DevAuth__Enabled=false
DevAuth__Username=
# Пароль НЕ хранить в файле репозитория. Пример безопасной установки:
#   dotnet user-secrets set "DevAuth:Password" "<ваш локальный пароль>" --project src/FormulaD.Mes.Api
DevAuth__Password=

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- SQL Server ---------------------------------------------------------------
# Строку подключения в файле НЕ хранить, задавать через user-secrets:
#   dotnet user-secrets set "Sql:ConnectionString" "Server=<host>;Database=<db>;User ID=<login>;Password=<...>;Encrypt=True"
# Sql__ConnectionString=
# Sql__CommandTimeoutSeconds=15
