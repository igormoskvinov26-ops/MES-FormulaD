bin/
obj/
node_modules/
dist/
.env
.env.local
appsettings.Production.json
appsettings.*.local.json
*.user
.DS_Store

# Корневой .gitignore репозитория игнорирует все *.png — возвращаем скриншоты интерфейса.
!docs/screenshots/*.png

# Референсные картинки концептов (docs/design/) не коммитим — как и *.png выше,
# это материал для сверки, а не часть репозитория.
docs/design/*.webp
wwwroot/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/

# Стенд: пароль и лог текущего запуска
stand/.run/

# Бэкап БД — хранится локально, не в репо (бинарный, ~768K+)
docker/backup/*.bak
