# ============================================================================
# Rubl Telegram Admin — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All secrets are read server-side only and are never exposed to the frontend,
# logs, generated Stories, or error responses.
# ============================================================================

# ---------------------------------------------------------------------------
# YCLIENTS
# ---------------------------------------------------------------------------
# Partner/application token (Bearer). Issued in the YCLIENTS partner cabinet.
YCLIENTS_PARTNER_TOKEN=
# User token (obtained via POST /api/v1/auth with a manager login/password).
# NOTE: a partner-level user token can read booking data (staff, working days,
# free windows) — enough for Stories. The daily REPORT needs a manager/admin
# user token (records/analytics), otherwise those endpoints return 403.
YCLIENTS_USER_TOKEN=
# Numeric company (branch) id — the salon location in YCLIENTS.
# РублЪ (Барбершоп Рубль) = 2036703 (confirmed against the live API).
YCLIENTS_COMPANY_ID=2036703
# Optional API base override (defaults to the public YCLIENTS API host).
# YCLIENTS_API_BASE=https://api.yclients.com/api/v1
#
# NOTE ON IDs: the work-schedule URL seen in the YCLIENTS web UI is
#   https://yclients.com/work_schedule/2036703/
# The trailing id (2036703) MUST NOT be assumed to be the company id, staff id,
# or application id. Verify it against real API responses before wiring it in.
# It is exposed here only as a hint, not as a hard-coded business id.
# YCLIENTS_WORK_SCHEDULE_HINT_ID=2036703

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# TEST contour — everything is sent here while TELEGRAM_MODE=test.
TELEGRAM_TEST_CHAT_ID=
# PRODUCTION contour — technically unreachable while TELEGRAM_MODE=test.
TELEGRAM_PRODUCTION_CHAT_ID=
# Business connection id required for Telegram Business Stories (postStory/editStory).
# Leave empty if not configured — the app degrades gracefully.
TELEGRAM_BUSINESS_CONNECTION_ID=

# Operating mode: `test` (default) or `production`.
# In `test` mode any production destination is blocked at the send layer.
TELEGRAM_MODE=test

# Dry run: perform every step (YCLIENTS query, calc, render, payload build)
# but do not physically send anything to Telegram.
TELEGRAM_DRY_RUN=true

# ---------------------------------------------------------------------------
# Booking
# ---------------------------------------------------------------------------
BOOKING_URL=https://n2387007.yclients.com

# ---------------------------------------------------------------------------
# Timezone — all business events are computed in Europe/Moscow.
# Do NOT rely on the server's system timezone.
# ---------------------------------------------------------------------------
TZ=Europe/Moscow

# ---------------------------------------------------------------------------
# Story publication schedule (HH:mm, Europe/Moscow)
# ---------------------------------------------------------------------------
STORY_MORNING_TIME=09:30
STORY_DAY_TIME=13:30
STORY_EVENING_TIME=17:30

# ---------------------------------------------------------------------------
# Daily management report (HH:mm, Europe/Moscow) — after the salon closes.
# ---------------------------------------------------------------------------
DAILY_REPORT_TIME=21:30

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=3000
# Comma-separated tokens that may call the admin API. If empty, the admin API is
# only reachable from localhost — so on any hosted deploy (Vercel) this MUST be
# set, and entered in the UI "admin token" field.
ADMIN_API_TOKENS=

# ---------------------------------------------------------------------------
# Deploy / storage (mainly for Vercel serverless — see DEPLOY.md)
# ---------------------------------------------------------------------------
# Encrypts the settings blob at rest. On Vercel/KV set this (any long random
# string). Locally it's optional (a generated data/.appkey is used instead).
APP_MASTER_KEY=
# Shared secret for the Vercel Cron endpoint (/api/cron/tick). Vercel sends it
# automatically as `Authorization: Bearer <CRON_SECRET>` when this env is set.
CRON_SECRET=
# Vercel KV (Upstash) — injected automatically when you connect a KV store to
# the project. When present, settings/state/locks use KV instead of local files.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Scheduler toggle — set to `false` to run the API without background jobs.
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Barber staff mapping (numeric YCLIENTS staff ids).
# Confirmed against the live РублЪ company (2036703) via the booking API.
# ---------------------------------------------------------------------------
BARBER_ARTASH_STAFF_ID=5659611
BARBER_KSENIA_STAFF_ID=5659614
BARBER_DMITRIY_STAFF_ID=5659617
